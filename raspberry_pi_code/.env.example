# Backend API (gaming PC)
BACKEND_URL=http://192.168.1.100:8000
DEVICE_TOKEN=your_device_token_here

# GPU inference server (Tier 2)
INFERENCE_SERVER_URL=http://192.168.1.100:8001

# Classification
# Order the Pi tries the tiers in. Any other value refuses to start.
#   gpu   Tier 2, then Tier 1. The default. Never calls Claude.
#   auto  Tier 1, then Tier 2, then Tier 3.
#   cloud Tier 3, then Tier 2, then Tier 1.
#   local Tier 1 only.
# auto and cloud turn Tier 3 on. See "Turn Tier 3 on" in SETUP.md.
TIER_PREFERENCE=gpu

# Escalation thresholds — a tier answering below its own bar hands the capture
# to the next one. Per tier, because a raw confidence means different things
# from each: Tier 2 softmaxes over 10,000 classes to Tier 1's 965, and Tier 1
# escalates to a free LAN GPU while Tier 2 escalates to a paid Claude call.
# Defaults below are measured, not guessed — see machine_learning/MODELS.md.
# Leave them commented to track the defaults.
# TIER1_CONFIDENCE_THRESHOLD=0.85
# TIER2_CONFIDENCE_THRESHOLD=0.60
# TIER3_CONFIDENCE_THRESHOLD=0.50

# The classifiers get a square crop around the detector's bird box. The side is
# the box's longer side plus this fraction of it on each side.
# CLASSIFY_CROP_MARGIN=0.25

# Tier 2 is on the LAN. A healthy GPU answers in well under a second.
TIER2_REQUEST_TIMEOUT=5
BACKEND_CONNECT_TIMEOUT=10
BACKEND_UPLOAD_TIMEOUT=60

# Trigger
# The only type is camera: a motion check, then a COCO bird detector.
# Any other value refuses to start.
TRIGGER_TYPE=camera

# The visit gap is the only repeat rule. One visit = the first bird detection after this many
# seconds with no bird detected.
CAMERA_VISIT_GAP_SECONDS=15
# Fraction of the small motion frame (0 to 1) that must change before the
# detector runs. Lower runs the detector more often.
CAMERA_MOTION_THRESHOLD=0.01
# Detector score that counts as a bird. See machine_learning/MODELS.md.
CAMERA_DETECTION_THRESHOLD=0.5
# Analysis ticks per second.
CAMERA_ANALYSIS_FPS=5
# DETECTOR_MODEL_PATH=/home/pi/peck_deck/machine_learning/efficientdet_lite0_detection.tflite
# The feeder's region, as fractions of the frame: x,y,width,height. The motion
# check and the detector see only this crop. Unset is the full frame. A bad value
# refuses to start. Example, the middle half of the frame: 0.25,0.25,0.5,0.5
# CAMERA_ROI=
# TFLite threads for the detector. 4 uses all four Pi 5 cores.
DETECTOR_THREADS=4

# Camera
IMAGE_WIDTH=1920
IMAGE_HEIGHT=1080
JPEG_QUALITY=90

# Local storage
CACHE_DIR=/var/lib/peck_deck/cache
MAX_CACHE_IMAGES=25
# Queued sightings are exempt from image eviction, so this bounds the cache
# during an outage. ~200 x 300 KB = ~60 MB.
MAX_QUEUED_SIGHTINGS=200
# Captures waiting for classify and upload while Tier 2 or the backend is slow.
# When it is full, a new capture goes to the offline queue as "Unknown".
CLASSIFY_QUEUE_SIZE=4

# ML models (defaults resolve relative to project root)
# MODEL_PATH=/home/pi/peck_deck/machine_learning/aiy_birds_V1_224_uint8.tflite
# TAXONOMY_PATH=/home/pi/peck_deck/machine_learning/taxonomy.csv

# Background sync interval (seconds)
SYNC_INTERVAL_SECONDS=60

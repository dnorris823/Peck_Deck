# ── Docker / Database ─────────────────────────────────────────────────────────
# Password for the PostgreSQL container.  Change before any internet exposure.
POSTGRES_PASSWORD=changeme

# ── Backend API ───────────────────────────────────────────────────────────────
# Overridden automatically by docker-compose to point at the db container.
# Only set this manually when running the backend outside Docker.
# DATABASE_URL=postgresql+asyncpg://peck_deck:changeme@localhost:5432/peck_deck

# JWT signing secret — must be long and random in production.
# With ENVIRONMENT=production the app REFUSES TO START if this is left at the
# shipped default or is shorter than 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_this_to_a_long_random_string
# How long a sign-in lasts. 30 days, so a push notification tapped days later
# opens the sighting instead of the login screen. Signing out, an owner password
# reset, or deleting the user revokes tokens early.
JWT_EXPIRE_HOURS=720

# "development" (default) or "production". Production additionally rejects
# insecure defaults at boot.
ENVIRONMENT=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API. Credentials are sent,
# so "*" is rejected — a wildcard plus credentials lets any site drive the API
# as the logged-in user. Defaults to the Vite dev server.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Upload limits ─────────────────────────────────────────────────────────────
# Max request body in bytes (default 15 MB). Pi sightings are ~300 KB; this
# leaves room for full-resolution frames while bounding memory use.
MAX_UPLOAD_BYTES=15728640

# ── Email notifications (M4) ──────────────────────────────────────────────────
SENDGRID_API_KEY=
NOTIFICATION_FROM_EMAIL=notifications@peckdeck.local

# ── Notification throttle (M4) ────────────────────────────────────────────────
# Minimum seconds between notifications per device (default 60).
NOTIFICATION_MIN_INTERVAL_SECONDS=60

# ── Weather on sightings ──────────────────────────────────────────────────────
# Each new sighting gets the weather at its device's city from Open-Meteo, which
# needs no key. Set to false on a backend with no internet access.
WEATHER_ENABLED=true

# ── Web push notifications (FLEDGE Phase 7) ───────────────────────────────────
# VAPID keypair identifying this server to browser push services (RFC 8292).
# Generate one with:  python scripts/generate_vapid_keys.py
# Leave blank to disable push: subscriptions are still accepted, nothing is sent,
# and the web app hides the opt-in (GET /push/config reports enabled=false).
#
# Keep the pair STABLE. Browsers bake the public key into their subscription, so
# rotating it silently invalidates every existing subscription. The private key
# is a signing key — treat it like JWT_SECRET and never commit it.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# Contact address the push service can use to reach you. mailto: or https:.
VAPID_SUBJECT=mailto:admin@peckdeck.local
# How long the push service should hold an undelivered alert (seconds).
PUSH_TTL_SECONDS=86400

# ── Live video ────────────────────────────────────────────────────────────────
# The read user in the Pi's MediaMTX config. The backend sends these when it
# relays a browser's WebRTC offer to the feeder. They must match the Pi exactly,
# or every offer fails with 502. See docs/live-video.md.
LIVE_READ_USER=
LIVE_READ_PASSWORD=
# MediaMTX's HLS port on the Pi, for browsers that cannot reach it over WebRTC.
LIVE_HLS_PORT=8888

# ── Tier 2 re-check ───────────────────────────────────────────────────────────
# Sightings the Pi classified while the inference server was off get a second
# look on the GPU once it answers again. See "Tier 2 re-check" in
# docs/operations.md. The default reaches the bare-metal server from the api
# container. 0 turns the re-check off.
# INFERENCE_SERVER_URL=http://host.docker.internal:8001
# TIER2_RECHECK_INTERVAL_SECONDS=60

# ── Cloud classification (Tier 3) ─────────────────────────────────────────────
# Off by default. The Pi calls Tier 3 only with TIER_PREFERENCE=auto or cloud in
# raspberry_pi_code/.env. Without a key, POST /classify returns 503 and the Pi
# moves on to the next tier. See "Turn Tier 3 on" in SETUP.md.
# ANTHROPIC_API_KEY=
